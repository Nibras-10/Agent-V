FROM python:3.12-slim AS builder
WORKDIR /build
COPY requirements.txt .
RUN python -m pip install --upgrade pip && python -m pip wheel --no-cache-dir --wheel-dir=/wheels -r requirements.txt

FROM python:3.12-slim AS runner
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api
WORKDIR /app
RUN groupadd --system --gid 10001 agent && useradd --system --uid 10001 --gid agent --home-dir /app agent
COPY --from=builder /wheels /wheels
COPY requirements.txt .
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt && rm -rf /wheels
COPY apps/api /app/apps/api
COPY migrations /app/migrations
COPY alembic.ini /app/alembic.ini
COPY docker/start-api.sh /app/docker/start-api.sh
RUN chmod 0555 /app/docker/start-api.sh && chown -R agent:agent /app
USER agent
EXPOSE 8000
CMD ["/app/docker/start-api.sh"]
