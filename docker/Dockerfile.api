# Multi-stage non-root Dockerfile for FastAPI Backend
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --upgrade pip && \
    pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -e .

FROM python:3.12-slim AS runner

WORKDIR /app

# Run as non-root user
RUN groupadd -g 1000 appgroup && \
    useradd -u 1000 -g appgroup -s /bin/bash -m appuser

COPY --from=builder /app/wheels /wheels
RUN pip install --no-cache-dir /wheels/* uvicorn fastapi pydantic pydantic-settings sqlalchemy alembic asyncpg aiosqlite redis pyjwt argon2-cffi httpx email-validator langgraph langgraph-checkpoint-postgres psycopg[binary,pool] langchain-core opentelemetry-api opentelemetry-sdk python-dotenv cryptography sentry-sdk

COPY apps/api /app/apps/api
COPY pyproject.toml /app/pyproject.toml

USER appuser

ENV PYTHONPATH=/app/apps/api
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
