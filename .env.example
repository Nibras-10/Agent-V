APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database (Supabase PostgreSQL / local PostgreSQL or SQLite fallback for tests)
DATABASE_URL=sqlite+aiosqlite:///./agent_v.db
# For production Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth & JWT Security
JWT_SIGNING_KEY=dev-insecure-secret-key-change-in-production-must-be-32-bytes-minimum!
JWT_ISSUER=agent-v-auth
JWT_AUDIENCE=agent-v-api
ACCESS_TOKEN_MINUTES=60

# LLM Configuration
# For Gemini, create an API key in Google AI Studio and paste it here.
# https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Agent Budgets & Constraints
MAX_AGENT_ATTEMPTS=3
MAX_LLM_CALLS_PER_RUN=8
MAX_TOOL_CALLS_PER_RUN=12
MAX_TOTAL_TOKENS_PER_RUN=10000

# Human-In-The-Loop Policies
APPROVAL_EXPIRY_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
